# ── Model selection (optional — defaults shown) ────────────────────────────────
REASONING_MODEL=claude-sonnet-4-20250514
CODE_MODEL=claude-sonnet-4-20250514

# ── Memory paths (optional) ───────────────────────────────────────────────────
# LTM_PATH=data/ltm.json
# VECTOR_STORE_PATH=data/vectors.json

# ── Jira (optional — omit to use demo data) ───────────────────────────────────
# JIRA_URL=https://your-org.atlassian.net
# JIRA_USER=you@yourorg.com
# JIRA_TOKEN=your_jira_api_token

# ── GitHub (optional — omit to use demo diff) ─────────────────────────────────
# GITHUB_TOKEN=ghp_your_token_here
# GITHUB_REPO=your-org/your-repo

# ── Slack (optional) ──────────────────────────────────────────────────────────
# SLACK_TOKEN=xoxb-your-slack-token
# SLACK_CHANNEL=#dev-updates


# Rate limiting
RATE_LIMIT_MAX_CALLS=30      # max LLM calls per window
RATE_LIMIT_WINDOW_SECONDS=60 # rolling window size

# Guardrail behaviour
BLOCK_ON_INJECTION=true      # false = warn only, don't block
MAX_INPUT_LENGTH=8000        # truncate inputs longer than this